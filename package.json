{
  "name": "yf-social",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "YF Social – Community Hub & Call-Aggregator (Prototyp für die YFN Member-Plattform)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "reset": "rm -f data/db.json && echo 'Datenbank zurückgesetzt – wird beim nächsten Start neu geseedet.'",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
